# 公開してよいLIFFアプリID。ローカル開発では .env.local に設定する。
# 本番は、この値を渡してビルドした dist を Cloudflare Pages へデプロイする。
VITE_SUWAPUYO_LIFF_ID=

# 旧会場案内所用の VITE_LIFF_ID は廃止予定。新規設定や複製はしない。

# ローカルの自動テスト専用。Cloudflare Pages / Vercel production には設定しない。
# VITE_SUWAPUYO_LIFF_MODE=demo

# LINE Messaging APIの管理用トークン。CLIでリッチメニューを登録するときだけ
# ローカルのシェル環境変数として設定する。 .env.local / Git / VITE_変数には置かない。
# LINE_CHANNEL_ACCESS_TOKEN=

# 将来Webhookでキーワード応答を実装し、LINE署名を検証するときだけ使う秘密値。
# Cloudflare Worker Secretに設定し、.env.local / Git / VITE_変数には置かない。
# LINE_CHANNEL_SECRET=
