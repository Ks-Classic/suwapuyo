{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suwapuyo.example/schemas/やっ太郎生成記録_スキーマ.json",
  "title": "Cousin Generation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "generationId",
    "assetId",
    "status",
    "characterMasterVersion",
    "promptTemplateVersion",
    "sourceRecipe",
    "provider",
    "model",
    "prompt",
    "inputs",
    "components",
    "output",
    "hardGate",
    "temporalQa",
    "reviews",
    "rights",
    "provenance"
  ],
  "properties": {
    "manifestVersion": { "type": "string", "const": "1.1.0" },
    "generationId": { "type": "string", "minLength": 1 },
    "assetId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["generated-draft", "selected-draft", "reviewed", "approved", "published", "deprecated", "revoked"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string" },
    "characterMasterVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "promptTemplateVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sourceRecipe": { "enum": ["deterministic-2d", "rigged-2d", "vrm-3d", "generated-image", "generated-video", "composited-hybrid"] },
    "provider": { "type": "string" },
    "surface": { "type": "string" },
    "model": { "type": "string" },
    "quality": { "enum": ["low", "medium", "high", "unknown"] },
    "size": { "type": "string" },
    "background": { "enum": ["opaque", "transparent", "unknown"] },
    "prompt": { "type": "string", "minLength": 1 },
    "requestedSingleChange": { "type": "string" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "assetId", "version", "sha256", "role", "approvalStatus", "rightsEvidenceIds"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "assetId": { "type": "string" },
          "version": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "role": { "enum": ["identity-anchor", "turnaround", "expression-pose", "style-palette", "scene-layout"] },
          "approvalStatus": { "enum": ["reviewed", "approved"] },
          "rightsEvidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/licensedComponent" }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "mediaType", "width", "height"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "mediaType": { "enum": ["image", "video"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "durationSeconds": { "type": ["number", "null"], "minimum": 0 },
        "manualCorrections": { "type": "array", "items": { "type": "string" } }
      }
    },
    "hardGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failures"],
      "properties": {
        "passed": { "type": "boolean" },
        "failures": { "type": "array", "items": { "type": "string" } }
      }
    },
    "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "temporalQa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "passed", "sampledFrames", "failures"],
      "properties": {
        "applicable": { "type": "boolean" },
        "passed": { "type": "boolean" },
        "sampledFrames": { "type": "integer", "minimum": 0 },
        "failures": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "reviewer", "status", "reviewedAt"],
        "properties": {
          "role": { "type": "string" },
          "reviewer": { "type": "string" },
          "status": { "enum": ["pending", "approved", "rejected", "changes-requested"] },
          "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
          "notes": { "type": "string" }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["証拠Ids", "commercialUse", "allowedPlatforms", "publishable"],
      "properties": {
        "証拠Ids": { "type": "array", "items": { "type": "string" } },
        "commercialUse": { "type": "boolean" },
        "allowedPlatforms": { "type": "array", "items": { "type": "string" } },
        "publishable": { "type": "boolean" },
        "deleteAfter": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "publicationUrls": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "supersedesAssetId": { "type": ["string", "null"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowAssetId", "workflowSha256", "コンテンツCredentials", "rollbackAssetId"],
      "properties": {
        "workflowAssetId": { "type": ["string", "null"] },
        "workflowSha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
        "コンテンツCredentials": { "enum": ["present", "absent", "not-supported", "unknown"] },
        "rollbackAssetId": { "type": ["string", "null"] },
        "sbomAssetId": { "type": ["string", "null"] }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "status": { "enum": ["approved", "published"] } },
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "required": ["score"],
        "properties": {
          "hardGate": {
            "type": "object",
            "properties": {
              "passed": { "const": true },
              "failures": { "type": "array", "maxItems": 0 }
            }
          },
          "score": { "type": "number", "minimum": 95, "maximum": 100 },
          "reviews": {
            "type": "array",
            "minItems": 3,
            "allOf": [
              { "type": "array", "contains": { "$ref": "#/$defs/authorReview" }, "minContains": 1 },
              { "type": "array", "contains": { "$ref": "#/$defs/brandReview" }, "minContains": 1 },
              { "type": "array", "contains": { "$ref": "#/$defs/rightsReview" }, "minContains": 1 }
            ]
          },
          "rights": {
            "type": "object",
            "properties": {
              "証拠Ids": { "type": "array", "minItems": 1 },
              "publishable": { "const": true }
            }
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "not": {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": { "commercialUseApproved": { "const": false } },
                "required": ["commercialUseApproved"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "sourceRecipe": { "const": "generated-video" }, "status": { "enum": ["approved", "published"] } },
        "required": ["sourceRecipe", "status"]
      },
      "then": {
        "type": "object",
        "properties": {
          "temporalQa": {
            "type": "object",
            "properties": {
              "applicable": { "const": true },
              "passed": { "const": true },
              "sampledFrames": { "type": "integer", "minimum": 3 },
              "failures": { "type": "array", "maxItems": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "status": { "const": "published" } },
        "required": ["status"]
      },
      "then": {
        "type": "object",
        "required": ["publicationUrls"],
        "properties": { "publicationUrls": { "type": "array", "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "licensedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "name", "version", "license", "licenseEvidence", "commercialUseApproved"],
      "properties": {
        "layer": { "enum": ["code", "workflow-engine", "custom-node", "base-model", "checkpoint", "adapter-lora", "input", "output", "font", "audio", "motion", "platform"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "licenseEvidence": { "type": "string", "minLength": 1 },
        "commercialUseApproved": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "approvedReview": {
      "type": "object",
      "properties": { "status": { "const": "approved" } },
      "required": ["role", "status"]
    },
    "authorReview": {
      "allOf": [
        { "$ref": "#/$defs/approvedReview" },
        { "type": "object", "properties": { "role": { "const": "author-design" } } }
      ]
    },
    "brandReview": {
      "allOf": [
        { "$ref": "#/$defs/approvedReview" },
        { "type": "object", "properties": { "role": { "const": "brand-product" } } }
      ]
    },
    "rightsReview": {
      "allOf": [
        { "$ref": "#/$defs/approvedReview" },
        { "type": "object", "properties": { "role": { "const": "production-rights" } } }
      ]
    }
  }
}
